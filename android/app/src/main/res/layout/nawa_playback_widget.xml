<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nawa_widget_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nawa_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">
    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_nawa" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">
        <TextView
            android:id="@+id/nawa_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/nawa_widget_queue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_open"
            android:textColor="#D9D2E6"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/nawa_widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_toggle"
        android:gravity="center"
        android:text="▶"
        android:textColor="#F1D9FC"
        android:textSize="19sp" />
    <TextView
        android:id="@+id/nawa_widget_next"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@string/widget_next"
        android:gravity="center"
        android:text="⏭"
        android:textColor="#F1D9FC"
        android:textSize="19sp" />
</LinearLayout>
